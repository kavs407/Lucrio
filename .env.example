NODE_ENV=production
PORT=3000
# Render fornece RENDER_EXTERNAL_URL automaticamente.
# Para domínio próprio, defina PUBLIC_URL com sua URL HTTPS exata.
# PUBLIC_URL=https://seu-servico.onrender.com
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA_CODIFICADA@HOST_SESSION_POOLER:5432/postgres
DATABASE_CA_CERT=
TRUST_PROXY=0

# Vendas: preencher somente no Render. Nunca comitar os valores reais.
KIWIFY_CHECKOUT_URL=
KIWIFY_PRODUCT_ID=
KIWIFY_WEBHOOK_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
# Em produção, a exigência de compra é automática. Para testes locais:
REQUIRE_PURCHASE=1
